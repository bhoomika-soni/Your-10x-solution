# Copy this file to .env and fill in your own values. Never commit .env.

PORT=3000

# PostgreSQL connection string. Matches docker-compose.yml by default.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/job_tracker

# Any long random string. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_secret

# Free, no-credit-card LLM provider (OpenAI-compatible API).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Illustrative $/1K-token rate used only to compute the cost log.
# Groq's free tier bills $0 — this rate exists so the cost log means
# something if you point LLM_BASE_URL at a paid provider instead.
LLM_COST_PER_1K_TOKENS=0.0002

# How often the background worker polls for pending match jobs (ms).
WORKER_INTERVAL_MS=3000
